# Upstream hostapd 2.11 template for 2.4 GHz (wl0).
# Copy to /etc/hostapd/wl0.conf on the device and set your real wpa_passphrase.
# NOTE: Do NOT set country_code= here; Broadcom wl.ko handles country via `wl country CN`
# and does not emit Linux CRDA regdom hints.
driver=nl80211
interface=wl0
bridge=br0
ctrl_interface=/run/hostapd
ctrl_interface_group=0

hw_mode=g
channel=6
beacon_int=100
dtim_period=1
wmm_enabled=1
auth_algs=1
ap_isolate=0
ignore_broadcast_ssid=0

ssid=OpenWrt-2.4G
wpa=2
wpa_key_mgmt=WPA-PSK
wpa_pairwise=CCMP
ieee80211w=0
wpa_passphrase=CHANGE_ME_24G_PASSPHRASE
